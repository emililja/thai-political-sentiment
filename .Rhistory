thai_mca_data <- wvs_raw %>%
# B_COUNTRY_ALPHA == "THA" or numeric code 764
filter(B_COUNTRY_ALPHA == "THA") %>%
select(
# e.g., Moral autonomy, gender deference, authority
Q33,  # Jobs scarce: men have more right
Q182, # Homosexuality justifiable
Q184, # Abortion justifiable
Q235  # Having a strong leader
) %>%
haven::as_factor()
